# Twelve Data API key -- free tier signup: https://twelvedata.com/
# Copy this file to .env (already gitignored) and fill in your key.
TWELVE_DATA_API_KEY=

# Binance's public market-data (klines/OHLC) endpoints need no API key.

# Alerting (architecture.md Layer 9) -- all optional. A channel only
# activates if its variable(s) are set; none set means no alerts are sent
# (not an error). See alerting/senders.py.
ALERT_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
